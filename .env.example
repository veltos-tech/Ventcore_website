# Публичный адрес сайта — для canonical, sitemap, Open Graph
NEXT_PUBLIC_SITE_URL=https://vent-core.com

# Подтверждение сайта в поисковиках (значение content из метатега, который покажут Google Search Console
# и Яндекс Вебмастер). Необязательно: подтвердить можно и записью TXT в DNS. После изменения нужна пересборка.
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=

# Реквизиты оператора берутся из src/content/requisites.ts; переменные ниже — необязательное переопределение.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_INN=
LEGAL_OPERATOR_ADDRESS=
LEGAL_OPERATOR_EMAIL=
# Установить в true после юридической проверки политики, соглашения и согласия — иначе страницы закрыты от индексации.
LEGAL_DOCUMENTS_APPROVED=false

# Telegram mini-CRM: секреты хранятся только на сервере, не передавайте их в чат.
TELEGRAM_BOT_TOKEN=
# Канал, на который клиент должен подписаться перед заявкой и связью с менеджером в боте:
# @username или числовой id (-100…). Бот обязательно должен быть АДМИНИСТРАТОРОМ канала,
# иначе проверить подписку нельзя (тогда клиентов не блокируем, а в логе появится предупреждение).
# По умолчанию — @ventcoreblog.
# TELEGRAM_CHANNEL_ID=@ventcoreblog
# Список Telegram user ID администраторов через запятую (только личные чаты).
TELEGRAM_ADMIN_IDS=
# Случайный секрет 32–256 символов A–Z, a–z, 0–9, _ или -.
TELEGRAM_WEBHOOK_SECRET=
# Полный HTTPS-адрес обработчика бота, например https://example.com/api/telegram/webhook
TELEGRAM_WEBHOOK_URL=
# Абсолютный путь к постоянной папке на VPS. Для разработки можно оставить пустым.
CRM_DB_PATH=
# Отдельный случайный секрет не короче 32 символов для фоновой отправки.
CRM_CRON_SECRET=
# Включить только за доверенным reverse proxy, который перезаписывает X-Real-IP.
CRM_TRUST_PROXY=0
# Папка резервных копий базы (абсолютный путь). По умолчанию backups/ рядом с базой;
# лучше указать другой диск. Копии автоматически создаёт таймер crm-tick.
# CRM_BACKUP_DIR=/var/lib/ventcore/backups
# Как часто делать плановую копию, в часах (1–168). По умолчанию 1.
# CRM_BACKUP_INTERVAL_HOURS=1
# Внутренний адрес приложения для systemd-таймера (только localhost).
CRM_INTERNAL_URL=http://127.0.0.1:3000
